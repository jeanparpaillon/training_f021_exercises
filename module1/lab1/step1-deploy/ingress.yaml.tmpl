# Shared cluster variant — see ingress-kind.yaml.tmpl for kind.
#
# One entry point for the whole application: only `productpage` is exposed,
# the other three services stay cluster-internal. That is the edge pattern
# from slot 1, with Ingress as the gateway.
#
# Render it into ingress.yaml (git-ignored), which the kustomization uses:
#
#   sed "s/CHANGEME/$NS/g" lab1/step1-deploy/ingress.yaml.tmpl \
#     > lab1/step1-deploy/ingress.yaml
#
# The cluster has a single public host name, so attendees are told apart by
# path: https://srv2052563.hstgr.cloud/<ns>/bookinfo/productpage. The
# middleware (installed by the trainer, see ../../../shared-cluster/) strips
# /<ns>/bookinfo, and productpage still sees /productpage.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: bookinfo
  annotations:
    traefik.ingress.kubernetes.io/router.middlewares: traefik-strip-ns-app@kubernetescrd
spec:
  ingressClassName: traefik
  rules:
    - host: srv2052563.hstgr.cloud
      http:
        paths:
          - path: /CHANGEME/bookinfo/productpage
            pathType: Prefix
            backend:
              service:
                name: productpage
                port:
                  number: 9080
          - path: /CHANGEME/bookinfo/static
            pathType: Prefix
            backend:
              service:
                name: productpage
                port:
                  number: 9080
          - path: /CHANGEME/bookinfo/login
            pathType: Prefix
            backend:
              service:
                name: productpage
                port:
                  number: 9080
          - path: /CHANGEME/bookinfo/logout
            pathType: Prefix
            backend:
              service:
                name: productpage
                port:
                  number: 9080
          - path: /CHANGEME/bookinfo/api/v1/products
            pathType: Prefix
            backend:
              service:
                name: productpage
                port:
                  number: 9080
