#!/usr/bin/env bash
# Generates trainees/: one <name>.yaml per trainee from
# templates/trainee.yaml.tmpl, and the kustomization listing them.
#
# Trainee names on stdin, one per line (first field; the rest is ignored), so
# that `make render` can feed it the names of the server's
# /root/users/consoles.txt without the passwords ever leaving the server:
#
#   ssh root@HOST "awk '{print \$1}' /root/users/consoles.txt" | bin/render
#
#   HOST            public host name of the consoles   (required)
#   CONSOLE_IMAGE   image of the consoles, name:tag    (required)
#
# Files of trainees no longer listed are removed from trainees/, but nothing
# is deleted from the cluster: `kubectl apply -k` does not prune.
set -euo pipefail
cd "$(dirname "$0")/.."

: "${HOST:?}" "${CONSOLE_IMAGE:?}"

out=trainees
mkdir -p "$out"
rm -f "$out"/*.yaml

names=()
while read -r name _; do
  case $name in ''|'#'*) continue ;; esac
  # Namespace, Service name and URL path: a DNS label.
  if ! [[ $name =~ ^[a-z0-9]([-a-z0-9]{0,40}[a-z0-9])?$ ]]; then
    echo "render: '$name' is not a valid namespace name, skipped" >&2
    continue
  fi
  sed -e "s/__NAME__/$name/g" -e "s/__HOST__/$HOST/g" templates/trainee.yaml.tmpl > "$out/$name.yaml"
  names+=("$name")
done

[ ${#names[@]} -gt 0 ] || { echo "render: no trainee" >&2; exit 1; }

{
  echo "# Generated by bin/render (make render)."
  echo "apiVersion: kustomize.config.k8s.io/v1beta1"
  echo "kind: Kustomization"
  echo "resources:"
  printf '  - %s.yaml\n' "${names[@]}"
  echo "images:"
  echo "  - name: console"
  echo "    newName: ${CONSOLE_IMAGE%:*}"
  echo "    newTag: \"${CONSOLE_IMAGE##*:}\""
} > "$out/kustomization.yaml"

echo "render: ${names[*]}"
