#!/usr/bin/env bash
# Runs ON THE SERVER, so the passwords never leave it (make secrets):
#
#   ssh root@HOST 'bash -s' < bin/secrets
#
# One Secret consoles/console-<name> per line of /root/users/consoles.txt
# (`<name> <password> <url>`): the password of the trainee's console, whose
# login is <name>. A console whose password changed is restarted, since ttyd
# reads it at start.
#
#   USERS   the users file      (default /root/users/consoles.txt)
#   CTX     kubectl context     (default kind-training-f021bis, which
#                                `kind create cluster` writes on the server)
set -euo pipefail

USERS=${USERS:-/root/users/consoles.txt}
CTX=${CTX:-kind-training-f021bis}
k() { kubectl --context "$CTX" "$@"; }

k create namespace consoles --dry-run=client -o yaml | k apply -f - >/dev/null

while read -r name pw _; do
  case $name in ''|'#'*) continue ;; esac
  printf '%-12s ' "$name"
  [ -n "$pw" ] || { echo "no password, skipped"; continue; }
  cur=$(k -n consoles get secret "console-$name" -o jsonpath='{.data.password}' 2>/dev/null | base64 -d || true)
  if [ "$cur" = "$pw" ]; then
    echo unchanged
    continue
  fi
  # --from-file: the password stays out of the process list.
  k -n consoles create secret generic "console-$name" \
    --from-file=password=<(printf %s "$pw") --dry-run=client -o yaml \
    | k label --local -f - console="$name" -o yaml \
    | k apply -f - >/dev/null
  if [ -n "$cur" ] && k -n consoles get deploy "console-$name" >/dev/null 2>&1; then
    k -n consoles rollout restart deploy "console-$name" >/dev/null
    echo "updated, console restarted"
  else
    echo created
  fi
done < "$USERS"
