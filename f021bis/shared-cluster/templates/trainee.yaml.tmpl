# Trainee __NAME__ — generated by bin/render from templates/trainee.yaml.tmpl
# (make render). Do not edit: edit the template.
#
#   namespace __NAME__            theirs; `admin` in it, cluster-admin on top
#                                 (base/trainees-cluster-admin.yaml)
#   console   consoles/console-__NAME__
#                                 ttyd at https://__HOST__/__NAME__/, login
#                                 `__NAME__`, password from Secret
#                                 consoles/console-__NAME__ (bin/secrets, from
#                                 the server's /root/users/consoles.txt)
#
# The console pod has two containers sharing localhost:
#
#   console   ttyd + bash, as root, home /root on a PVC; kubectl, kind, helm,
#             docker CLI, ansible (console/Dockerfile). Its kubeconfig has a
#             context `training-f021bis` for this cluster (ServiceAccount
#             token), created by console-init.
#   dind      a privileged Docker daemon, socket shared through an emptyDir,
#             images and containers on a PVC. `kind create cluster` in the
#             console runs its nodes there; kind's API port mapping is on
#             127.0.0.1 of the pod, which the console shares, so the
#             kubeconfig kind writes works as is.
#
# No TCP socket for Docker: dockerd listens on the unix socket only, so other
# pods cannot reach it.
apiVersion: v1
kind: Namespace
metadata:
  name: __NAME__
  labels:
    f021bis/trainee: __NAME__
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: trainee-admin
  namespace: __NAME__
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: admin
subjects:
  - { kind: ServiceAccount, name: console-__NAME__, namespace: consoles }
  - { apiGroup: rbac.authorization.k8s.io, kind: User, name: __NAME__ }
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: console-__NAME__
  namespace: consoles
  labels:
    console: __NAME__
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: console-__NAME__-home
  namespace: consoles
  labels:
    console: __NAME__
spec:
  storageClassName: standard
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 5Gi
---
# /var/lib/docker of the dind sidecar: pulled images (kindest/node is ~1 GB)
# and the nodes of the trainee's kind clusters survive a pod restart. The
# clusters themselves come back stopped: `docker start $(docker ps -aq)`.
# local-path does not enforce the size.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: console-__NAME__-docker
  namespace: consoles
  labels:
    console: __NAME__
spec:
  storageClassName: standard
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 30Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: console-__NAME__
  namespace: consoles
  labels:
    console: __NAME__
spec:
  replicas: 1
  strategy:
    type: Recreate          # RWO volumes
  selector:
    matchLabels:
      console: __NAME__
  template:
    metadata:
      labels:
        console: __NAME__
    spec:
      serviceAccountName: console-__NAME__
      containers:
        - name: console
          image: console
          args:
            - ttyd
            - --writable
            - --port=7681
            - --base-path=/__NAME__
            - --credential=__NAME__:$(CONSOLE_PASSWORD)
            - bash
            - -l
          env:
            - name: CONSOLE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: console-__NAME__
                  key: password
            - name: NS
              value: __NAME__
            - name: DOCKER_HOST
              value: unix:///run/docker/docker.sock
          workingDir: /root
          ports:
            - name: http
              containerPort: 7681
          volumeMounts:
            - name: home
              mountPath: /root
            - name: docker-sock
              mountPath: /run/docker
          resources:
            requests: {cpu: 50m, memory: 128Mi}
            limits: {memory: 2Gi}
        - name: dind
          image: docker:29.9.0-dind
          # $1 = dockerd: the entrypoint still sets up cgroup nesting (dind
          # wrapper) but adds none of its default --host flags, among them an
          # unauthenticated tcp://0.0.0.0:2375 when TLS is off.
          command: [dockerd-entrypoint.sh]
          args:
            - dockerd
            - --host=unix:///run/docker/docker.sock
          env:
            - name: DOCKER_TLS_CERTDIR
              value: ""
          securityContext:
            privileged: true
          volumeMounts:
            - name: docker-sock
              mountPath: /run/docker
            - name: docker-data
              mountPath: /var/lib/docker
            # kind mounts these into its nodes (kube-proxy, CNI modules).
            - name: modules
              mountPath: /lib/modules
              readOnly: true
          # No limits: a kind cluster takes ~1 CPU and 1-2 GiB per node.
          resources:
            requests: {cpu: 100m, memory: 256Mi}
      volumes:
        - name: home
          persistentVolumeClaim:
            claimName: console-__NAME__-home
        - name: docker-data
          persistentVolumeClaim:
            claimName: console-__NAME__-docker
        - name: docker-sock
          emptyDir: {}
        - name: modules
          hostPath:
            path: /lib/modules
            type: Directory
---
apiVersion: v1
kind: Service
metadata:
  name: console-__NAME__
  namespace: consoles
  labels:
    console: __NAME__
spec:
  selector:
    console: __NAME__
  ports:
    - name: http
      port: 7681
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: console-__NAME__
  namespace: consoles
  labels:
    console: __NAME__
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
spec:
  ingressClassName: traefik
  rules:
    - host: __HOST__
      http:
        paths:
          - path: /__NAME__
            pathType: Prefix
            backend:
              service:
                name: console-__NAME__
                port:
                  name: http
