# Versions of module 2, in one place. Sourced by the step files
# (`source versions.env`, from module2/) and included by the Makefiles: plain
# KEY=value, no quotes, no spaces, so both bash and make read it.
#
# STATUS: to validate on the first dry run. Values marked TODO must be filled
# from the pinned Kubespray release before anything is run:
#   - KUBESPRAY_VERSION: the newest release at dry-run time;
#   - KUBE_TO: that release's default kube_version
#     (roles/kubespray_defaults/defaults/main/main.yml);
#   - KUBE_FROM: the newest patch of the previous minor listed in its
#     checksums (roles/kubespray_defaults/vars/main/checksums.yml). Lab 3
#     upgrades from one to the other with the SAME Kubespray release, so both
#     must be in its supported range (kube_version_min_required).
# Kubespray's kube_version has no leading "v".

KUBESPRAY_VERSION=TODO-v2.31.N
KUBE_FROM=TODO-1.34.N
KUBE_TO=TODO-1.35.N

# Lab 2 runs on kind, with the console's kind v0.33.0 and module 1's node
# image (already pulled in every console for module 1).
KIND_NODE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Collection and its Python client, installed in the module's venv on top of
# Kubespray's requirements.txt (which pins ansible-core).
KUBERNETES_CORE_VERSION=TODO-6.N.N
PYTHON_KUBERNETES_VERSION=TODO-33.N.N
ANSIBLE_POSIX_VERSION=TODO-2.N.N

# Flux: the F021 fleet's version (f021-fleet, clusters/hstgr/flux-system).
FLUX_VERSION=TODO-v2.N.N

# Lab 2 step 4: podinfo's Helm chart; step 6: what Flux deploys.
PODINFO_CHART_VERSION=TODO-6.N.N

# Lab 1 / lab 3 nodes: image built by lab0 in the console's Docker.
NODE_IMAGE=m2-node:latest
NODE_BASE=ubuntu:24.04
NODE_NETWORK=m2
NODE_SUBNET=172.30.2.0/24
