# Versions of module 1, in one place. Sourced by the step files
# (`source versions.env`, from module1/) and included by the Makefiles: plain
# KEY=value, no quotes, no spaces, so both bash and make read it.
#
# K8S_FROM / K8S_TO are one minor apart on purpose: lab 3 upgrades `prod`
# from one to the other. Both node images are the ones kind v0.33.0 (the
# console's kind) was released with; the digests are from its release notes.

K8S_FROM=v1.36.4
KIND_NODE_FROM=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
K8S_TO=v1.37.0
KIND_NODE_TO=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Linkerd edge: chart version 2026.M.N is CLI / image edge-26.M.N.
# LINKERD_TO is the F021 fleet's release.
LINKERD_FROM=2026.8.4
LINKERD_CLI_FROM=edge-26.8.4
LINKERD_TO=2026.9.3
LINKERD_CLI_TO=edge-26.9.3

STEP_VERSION=0.31.0
VELERO_VERSION=v1.18.4
VELERO_AWS_PLUGIN_VERSION=v1.14.4
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48
K6_IMAGE=grafana/k6:2.3.0
BOOKINFO_VERSION=1.20.3

# Gateway API CRDs, which Linkerd needs and does not install (same bundle as
# the F021 fleet).
GATEWAY_API_VERSION=v1.4.0
